# Cloudflare Pages: existing files in dist/ win first (prerendered HTML, XML, assets).
# Rules below only apply when no matching file exists.

# Merchant / SEO aliases
/google-merchant.xml /merchant-feed.xml 200
/feeds/google-merchant.xml /merchant-feed.xml 200

# Legacy WooCommerce → canonical SPA (single hop 301)
/product/:slug  /da/produkt/:slug  301
/product/:slug/ /da/produkt/:slug  301
/da/product/:slug /da/produkt/:slug 301
/en/product/:slug /da/produkt/:slug 301

/product-category/*  /da/kategori/:splat  301
/da/product-category/* /da/kategori/:splat 301
/en/product-category/* /da/kategori/:splat 301

